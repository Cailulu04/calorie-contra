# Copy to .env and fill in your keys (never commit .env)

# Flask session signing — use a long random string
SECRET_KEY=change-me-to-a-long-random-string

# USDA FoodData Central: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=your_usda_api_key_here

# Google Gemini (chat, image recognition): https://aistudio.google.com/apikey
gemini_api_key=your_gemini_api_key_here

# Optional: override local dev port (default 5001 on macOS)
# PORT=5001
